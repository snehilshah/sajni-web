{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "headers": [
    {
      "source": "/((?!api/|assets/|favicon/|_vercel/|.*\\.[a-zA-Z0-9]+$).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/oauth/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sajni-api-a7bzmoi2qq-el.a.run.app/api/:path*"
    },
    {
      "source": "/mcp",
      "destination": "https://sajni-api-a7bzmoi2qq-el.a.run.app/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://sajni-api-a7bzmoi2qq-el.a.run.app/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "https://sajni-api-a7bzmoi2qq-el.a.run.app/.well-known/oauth-protected-resource/:path*"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://sajni-api-a7bzmoi2qq-el.a.run.app/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "https://sajni-api-a7bzmoi2qq-el.a.run.app/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "https://sajni-api-a7bzmoi2qq-el.a.run.app/.well-known/openid-configuration"
    },
    {
      "source": "/((?!assets/|favicon|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
